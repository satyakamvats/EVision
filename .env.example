# Docker Compose configuration. Copy this file to .env for local overrides.
# Defaults are safe for local development; keep real secrets out of Git.
POSTGRES_DB=evision
POSTGRES_USER=evision
POSTGRES_PASSWORD=evision
EVISION_DB_PORT=5433
EVISION_BACKEND_PORT=8000
EVISION_FRONTEND_PORT=5173

EVISION_MODE=synthetic_replay
EVISION_ROUTING_PROVIDER=osrm
EVISION_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
EVISION_OCM_API_KEY=
EVISION_ELECTRICITY_MAPS_API_KEY=
EVISION_SUPABASE_URL=
EVISION_SUPABASE_JWKS_URL=
EVISION_SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=
